*~

# operating system
.DS_Store
Thumbs.db
desktop.ini

# The generated data, figures and run logs ARE part of the archive: keep them tracked
# even if a user-level ignore file excludes logs, PDFs or images.
!data/
!data/*.csv
!data/*.json
!output/
!output/*.pdf
!output/*.png
!output/*.log
